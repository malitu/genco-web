# GENCO - ortam değişkenleri
#
# Bu dosya örnek şablondur; kendi anahtarlarınızı buraya YAZMAYIN.
# Gerçek anahtarlarınızı Vercel'de 'Project' → 'Settings' → 'Environment
# Variables' bölümünden tanımlayın.

# --- İletişim formu e-posta gönderimi ---------------------------------------
# Web3Forms (https://web3forms.com) erişim anahtarı.
# Paneldeyken "Access Key" olarak görünür. Sunucuda gizli kalır.
WEB3FORMS_KEY=

# --- CAPTCHA: Cloudflare Turnstile ------------------------------------------
# https://dash.cloudflare.com → Turnstile → Add widget
# Site Key tarayıcıya gider (gizli değildir, normaldir).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret Key yalnızca sunucuda kullanılır, ASLA istemciye gönderilmez.
TURNSTILE_SECRET_KEY=
# "0" yapılırsa CAPTCHA hiç yüklenmez (acil durumda kapatmak için).
NEXT_PUBLIC_TURNSTILE=1

# --- Trafik ölçümü (GA4) ------------------------------------------------------
# Google Analytics 4 "Ölçüm Kimliği" (Measurement ID), G-XXXXXXX biçiminde.
# Boş bırakılırsa sitede hiçbir analitik kodu yüklenmez (site normal çalışır).
NEXT_PUBLIC_GA_ID=

# --- Site adresi (SEO) --------------------------------------------------------
# Canlı alan adı. Metadata, sitemap, robots.txt ve Open Graph bunu kullanır.
# Alan adı Vercel'e taşınmadan önce geçici olarak vercel.app adresini verin:
#   NEXT_PUBLIC_SITE_URL=https://genco-web.vercel.app
NEXT_PUBLIC_SITE_URL=https://www.gencotr.com

# --- Firebase (stüdyodan eklenen özel sayfalar için) ------------------------
# sitemap.js ve [slug] sayfasının meta üretimi bu değerleri okur.
# API Key zaten sayfanın HTML'inde görünür (gizli değildir); burada yalnızca
# sunucu tarafında okunması kolaylık sağlıyor.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=genco-platform
NEXT_PUBLIC_FIREBASE_API_KEY=